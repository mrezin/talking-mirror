# Firebase Functions / CLI environment template.
# Copy to `.env` (gitignored) and fill in for local emulation and manual deploys.

# Target Firebase project id (matches .firebaserc / Firebase console).
FIREBASE_PROJECT_ID=

# CI deploy token from `firebase login:ci`. In CI this is provided via the
# FIREBASE_TOKEN GitHub Secret (see .github/workflows/firebase-deploy.yml);
# set it here only for local manual deploys.
FIREBASE_TOKEN=
