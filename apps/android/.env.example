# Firebase Web App configuration for the Android Expo app.
# Copy this file to `.env` (which is gitignored) and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app SDK config.
# All EXPO_PUBLIC_* vars are inlined into the client bundle by app.config.js.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud console / Firebase Auth Google provider).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Expo Application Services project id (expo.dev). Optional for local dev.
EAS_PROJECT_ID=
