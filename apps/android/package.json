{
  "name": "@talking-mirror/android",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prebuild": "expo prebuild",
    "eas:build:android": "eas build --platform android",
    "eas:submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@talking-mirror/ios": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "typescript": "^5.4.5"
  },
  "note": "Android shares source code with the iOS workspace. This package.json enables Android-specific build scripts and EAS configuration."
}
