{
  "name": "talking-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "TalkingMirror monorepo — daily selfie mirror app with compliments, affirmations & lucky colors",
  "workspaces": [
    "apps/ios",
    "apps/android",
    "services/firebase",
    "services/revenuecat",
    "packages/shared"
  ],
  "scripts": {
    "ios": "npm -w @talking-mirror/ios run start",
    "android": "npm -w @talking-mirror/android run start",
    "build:ios": "npm -w @talking-mirror/ios run eas:build:ios",
    "build:android": "npm -w @talking-mirror/android run eas:build:android",
    "deploy:firebase": "npm -w @talking-mirror/firebase run deploy",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "postinstall": "patch-package"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "@talking-mirror/android": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "expo": "~56.0.11",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
