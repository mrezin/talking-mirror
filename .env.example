# Root environment template for local development.
# Copy to `.env` (gitignored) and fill in. The mobile apps read their own
# apps/<platform>/.env files; this root file holds shared/tooling values.

# Firebase project id used by the Firebase CLI and emulators.
FIREBASE_PROJECT_ID=

# Firebase CI deploy token (firebase login:ci). Used by the firebase-deploy
# workflow as the FIREBASE_TOKEN GitHub Secret; only needed locally for manual
# `firebase deploy` runs.
FIREBASE_TOKEN=

# Expo Application Services project id (expo.dev).
EAS_PROJECT_ID=
